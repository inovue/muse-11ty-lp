<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }} — {{ site.tagline }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ site.name }} — {{ site.tagline }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  {% include "partials/header.njk" %}
  <main>{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  <script src="{{ '/js/main.js' | url }}" defer></script>
</body>
</html>
