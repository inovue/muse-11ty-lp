---
layout: layouts/base.njk
title: トップ
---

<section class="hero">
  <div class="hero-media">
    <img src="{{ '/img/hero.webp' | url }}" alt="日差しの入る木のカウンターと棚の店内" fetchpriority="high">
    <h1 class="hero-title">日々の、<br>一杯。</h1>
  </div>
  <p class="hero-vertical" aria-hidden="true">静かな時間を、淹れる。</p>
  <p class="hero-lead">
    清澄白河の小さな自家焙煎店です。毎朝、豆を手作業で焙煎し、丁寧に抽出します。
    特別な日ではなく、いつもの一杯を。
  </p>
</section>

<section id="concept" class="section reveal">
  <p class="sec-label"><span>01</span> — CONCEPT</p>
  <div class="concept-grid">
    <div>
      <h2>焙煎は、<br>朝の仕度から。</h2>
      <p>
        毎朝、豆を手作業で焙煎し、丁寧に抽出します。日々の繰り返しが、静かな時間をつくります。
        特別な日ではなく、いつもの一杯を。私たちは、その一杯に心を込めています。
      </p>
    </div>
    <figure class="concept-photo">
      <img src="{{ '/img/drip.webp' | url }}" alt="ハンドドリップで珈琲を淹れる様子" loading="lazy">
    </figure>
  </div>
</section>

<section id="menu" class="section reveal">
  <p class="sec-label"><span>02</span> — MENU</p>
  <h2 class="sec-title">メニュー</h2>
  <div class="menu-grid">
    <ul class="menu-list">
      {% for item in menu %}
      <li>
        <span class="menu-name">{{ item.name }}</span>
        <span class="menu-dots" aria-hidden="true"></span>
        <span class="menu-price">¥{{ item.price }}</span>
      </li>
      {% endfor %}
    </ul>
    <figure class="menu-photo">
      <img src="{{ '/img/latte.webp' | url }}" alt="ラテアートのカフェラテ" loading="lazy">
    </figure>
  </div>
  <p class="note">※ 豆は季節により変わります。店頭でお尋ねください。</p>
</section>

<section id="beans" class="section reveal">
  <p class="sec-label"><span>03</span> — BEANS</p>
  <h2 class="sec-title">豆の販売</h2>
  <figure class="beans-photo">
    <img src="{{ '/img/beans.webp' | url }}" alt="自家焙煎の珈琲豆の袋" loading="lazy">
  </figure>
  <div class="beans-grid">
    {% for bean in beans %}
    <article class="bean">
      <h3>{{ bean.name }}</h3>
      <p>{{ bean.notes }}</p>
      <p class="bean-price">{{ bean.price }}</p>
    </article>
    {% endfor %}
  </div>
</section>

<section id="gallery" class="section reveal">
  <p class="sec-label"><span>04</span> — GALLERY</p>
  <h2 class="sec-title">ギャラリー</h2>
  <div class="gallery">
    <img class="g-a" src="{{ '/img/hero.webp' | url }}" alt="店内の木の棚とカウンター" loading="lazy">
    <img class="g-b" src="{{ '/img/latte.webp' | url }}" alt="カフェラテ" loading="lazy">
    <img class="g-c" src="{{ '/img/drip.webp' | url }}" alt="ドリップの様子" loading="lazy">
    <img class="g-d" src="{{ '/img/beans.webp' | url }}" alt="珈琲豆の袋" loading="lazy">
  </div>
</section>

<section id="access" class="section reveal">
  <p class="sec-label"><span>05</span> — ACCESS</p>
  <h2 class="sec-title">店舗案内</h2>
  <div class="access-grid">
    <dl class="access-list">
      <div><dt>住所</dt><dd>{{ site.address }}<br>{{ site.station }}</dd></div>
      <div><dt>営業時間</dt><dd>{{ site.hours }}</dd></div>
      <div><dt>定休日</dt><dd>{{ site.closed }}</dd></div>
      <div><dt>お問い合わせ</dt><dd><a href="mailto:{{ site.email }}">{{ site.email }}</a></dd></div>
    </dl>
    <a class="map-card" href="{{ site.map }}" target="_blank" rel="noreferrer">
      <span class="map-pin" aria-hidden="true">●</span>
      <span>Google マップで見る</span>
      <small>清澄白河駅から徒歩5分</small>
    </a>
  </div>
</section>
